# Public origin used by Better Auth (no trailing slash).
PUBLIC_ORIGIN=http://localhost:5173

# Random 32+ byte secret. `npm run cli init-env` fills empty secrets.
# Never commit a real value — copy this file to .env (gitignored).
BETTER_AUTH_SECRET=

# Seeded on first boot. There is no public author signup.
AUTHOR_EMAIL=you@example.com

# SQLite and documents/. Compose bind-mounts this host path at /data.
DATA_DIR=./data

# The uid and gid the Compose app runs as. The container is not root, so it can
# only write to DATA_DIR if that folder belongs to this uid. `npm run cli
# init-env` creates DATA_DIR and fills these with your own, so files stay yours.
# APP_UID=
# APP_GID=

# Hostname for Caddy / passkeys. Use localhost in development.
DOMAIN=localhost

# Optional: send email OTP recovery and (later) notifications.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Glassine <glassine@example.com>

# Optional: extra Better Auth origins (comma-separated). Localhost already allows Vite/Playwright ports.
# BETTER_AUTH_TRUSTED_ORIGINS=https://glassine.example.com

# Optional git / Obsidian adapter. `npm run cli init-env --git` sets the profile and tokens.
# COMPOSE_PROFILES=git
# Hostname the git remote is served on. It needs its own DNS record and, with
# Caddy, is issued its own certificate. `init-env --git` fills it from DOMAIN
# (glassine-git plus the parent domain), so both glassine.example.com and
# example.com give glassine-git.example.com. Set it yourself to choose another.
# GIT_DOMAIN=
# GIT_HTTP_TOKEN=
# GIT_SYNC_SECRET=
# GIT_REMOTE_URL=https://glassine-git.example.com/glassine.git
# GIT_SYNC_URL=http://app:3000/api/adapter/sync
#
# Vite + git sidecar (no Compose app, no Caddy on :80/:443):
#   npm run cli init-env --git --loopback
# COMPOSE_FILE=compose.yaml:compose.loopback.yaml

# Optional backup profile (COMPOSE_PROFILES=backup or `docker compose --profile backup up`).
# Where Litestream copies the SQLite database, e.g. s3://my-bucket/glassine
# For S3-compatible storage also set the two keys. Use a bucket only Glassine can write to.
# See documentation/install.md ("Backups").
# LITESTREAM_REPLICA_URL=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
