{
	"name": "glassine",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"cli": "tsx scripts/cli.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"audit:lockfile": "node scripts/check-lockfile.mjs",
		"audit:deps": "npm audit --omit=dev --audit-level=high && node scripts/check-lockfile.mjs",
		"update": "./scripts/update.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/mdast": "^4.0.4",
		"drizzle-kit": "^0.31.4",
		"svelte": "5.57.0",
		"svelte-check": "^4.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.5",
		"@better-auth/passkey": "1.7.5",
		"@fontsource-variable/inter": "^5.3.0",
		"@handlewithcare/prosemirror-suggest-changes": "file:vendor/prosemirror-suggest-changes",
		"better-auth": "1.7.5",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-history": "^1.4.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "1.25.11",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-state": "1.4.4",
		"prosemirror-transform": "1.12.1",
		"prosemirror-view": "1.42.3",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"tsx": "^4.20.5",
		"unified": "^11.0.5",
		"zod": "^4.5.4"
	},
	"overrides": {
		"prosemirror-model": "1.25.11",
		"prosemirror-view": "1.42.3",
		"prosemirror-state": "1.4.4",
		"prosemirror-transform": "1.12.1"
	}
}
